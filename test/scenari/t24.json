[{"mode": "ffa", "map": "morioh", "n": 2, "pick": [0, 1], "secs": 1, "fire": false, "move": false, "pre": "1", "post": "(()=>{const st={};mapGroup.traverse(o=>{if(!o.isMesh||o.userData.own)return;let v=true,q=o;while(q){if(!q.visible){v=false;break;}q=q.parent;}if(!v)return;const m=Array.isArray(o.material)?o.material[0]:o.material;if(m.map||m.type!=='MeshStandardMaterial')return;let dynA=false;q=o.parent;while(q&&q!==mapGroup){if(q.userData.dyn)dynA=true;q=q.parent;}const k=(o.userData.dyn?'selfdyn':'')+(dynA?'dynAnc':'')+(o.children.length?'kids':'')+(o.renderOrder?'ro':'')+(m.emissive&&(m.emissive.r||m.emissive.g||m.emissive.b)?'emis':'')+(Array.isArray(o.material)?'multi':'')+('|'+o.geometry.type)+'|r'+m.roughness.toFixed(2);st[k]=(st[k]||0)+1;});return JSON.stringify(Object.entries(st).sort((a,b)=>b[1]-a[1]).slice(0,25));})()"}]